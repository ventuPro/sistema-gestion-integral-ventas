# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sgiv_db
DB_USER=sgiv_user
DB_PASSWORD=sgiv_password

# Seguridad
# Secreto para firmar los tokens (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Orígenes extra permitidos por CORS, separados por coma (opcional).
# localhost, la red local y el mismo host del backend ya están permitidos.
# Ejemplo: CORS_ORIGINS=https://rickys.com,https://www.rickys.com
CORS_ORIGINS=

# Servidor
PORT=3000