# Variables para docker-compose (copiar a .env en esta misma carpeta)

# Secreto para firmar los tokens (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Orígenes extra permitidos por CORS, separados por coma (opcional)
CORS_ORIGINS=
